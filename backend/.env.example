# SQL Server Authentication example. Set DB_TRUSTED_CONNECTION=yes instead
# of DB_USER/DB_PASSWORD when using Windows Authentication.
DB_HOST=localhost
DB_PORT=1434
DB_NAME=transport
DB_USER=sa
DB_PASSWORD=password@12345
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=no
DB_ENCRYPT=no

SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
ADMIN_EMAIL=admin@cargomax.com
ADMIN_PASSWORD=change-this-admin-password
